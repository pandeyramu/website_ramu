# Copy to .env and fill in real values. NEVER commit this file.
NEON_DATABASE_URL=postgres://user:pass@host/dbname
SUPABASE_DATABASE_URL=postgres://postgres.[ref]:[pass]@aws-0-region.pooler.supabase.com:5432/postgres

RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=srv-xxxxx

SITE_URL=https://pandeyramu.com.np/
FAILURES_BEFORE_FLIP=3

# Optional: run this (shell command) after a failed flip-back to refresh the standby.
SYNC_HOOK_ON_FLIP_BACK=python scripts/db_sync.py --sync-all --mode replace --direction neon-to-supabase